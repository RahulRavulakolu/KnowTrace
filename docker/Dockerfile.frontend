# ==========================================
# KnowTrace Frontend Dockerfile (Next.js 14)
# ==========================================
FROM node:20-alpine as base

WORKDIR /app

ENV NODE_ENV=development \
    NEXT_TELEMETRY_DISABLED=1

COPY frontend/package*.json ./
RUN npm install

COPY frontend/ ./

EXPOSE 3000

CMD ["npm", "run", "dev"]
