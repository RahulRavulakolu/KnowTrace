# ============================================================
# KnowTrace Backend Dockerfile (Python 3.11)
# ============================================================
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1

# Install system dependencies:
# - ffmpeg (video & audio extraction)
# - libreoffice (PPTX/DOCX slide conversion)
# - tesseract-ocr (OCR for figure & slide extraction)
# - poppler-utils (PDF rendering & extraction)
# - libgl1, libglib2.0-0 (OpenCV / PyMuPDF vision support)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    pkg-config \
    ffmpeg \
    libavcodec-dev \
    libavdevice-dev \
    libavfilter-dev \
    libavformat-dev \
    libavutil-dev \
    libswresample-dev \
    libswscale-dev \
    libreoffice-writer \
    libreoffice-impress \
    tesseract-ocr \
    poppler-utils \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install pinned Python dependencies
COPY requirements.txt .
RUN pip install --upgrade pip && \
    pip install -r requirements.txt

# Copy codebase
COPY backend/ backend/
COPY database/ database/
COPY scripts/ scripts/
COPY tests/ tests/
COPY pyproject.toml .
COPY alembic.ini .

# Create cache and upload directories
RUN mkdir -p /app/uploads /app/logs /app/data/cache && chmod -R 777 /app/uploads /app/logs /app/data

EXPOSE 8000

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
