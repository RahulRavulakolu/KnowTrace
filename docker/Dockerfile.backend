# ============================================================
# KnowTrace Backend Dockerfile (Python 3.11)
# ============================================================
FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1

# Configure apt retries to handle transient mirror network hiccups
RUN echo 'Acquire::Retries "3";' > /etc/apt/apt.conf.d/80-retries && \
    echo 'Acquire::http::Timeout "60";' >> /etc/apt/apt.conf.d/80-retries

# Install runtime system dependencies:
# - ffmpeg (video & audio extraction for Whisper / SceneDetect)
# - libreoffice (headless PPTX/DOCX slide conversion)
# - tesseract-ocr (OCR for figure & slide extraction)
# - poppler-utils (PDF rendering & extraction)
# - libgl1, libglib2.0-0 (PyMuPDF / OpenCV vision support)
RUN apt-get update && apt-get install -y --fix-missing --no-install-recommends \
    build-essential \
    curl \
    pkg-config \
    ffmpeg \
    libreoffice-writer \
    libreoffice-impress \
    tesseract-ocr \
    poppler-utils \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install pinned Python dependencies
COPY requirements.txt .
RUN pip install --upgrade pip && \
    pip install -r requirements.txt

# Copy codebase
COPY backend/ backend/
COPY database/ database/
COPY services/ services/
COPY scripts/ scripts/
COPY tests/ tests/
COPY pyproject.toml .
COPY alembic.ini .

# Create cache and upload directories
RUN mkdir -p /app/uploads /app/logs /app/data/cache && chmod -R 777 /app/uploads /app/logs /app/data

EXPOSE 8000

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
