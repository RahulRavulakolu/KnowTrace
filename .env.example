# KnowTrace Environment Configuration

# ─── Application ─────────────────────────────────────────
APP_NAME=KnowTrace
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000
VERSION=1.0.0

# ─── Database (PostgreSQL 16 + pgvector) ─────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=knowtrace
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/knowtrace

# ─── Redis & RQ ──────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ─── LLM Providers ──────────────────────────────────────
# Vendor A (Generation, Vision, Long Context)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Vendor B (Validation, Grading, Judging)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-haiku-20240307

# ─── LLM Cache ───────────────────────────────────────────
LLM_CACHE_DIR=data/cache
LLM_CACHE_SIZE_LIMIT=1073741824
LLM_CACHE_ENABLED=true

# ─── Embeddings & Retrieval ──────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
VECTOR_DIMENSION=1024

# ─── Security / CORS ────────────────────────────────────
SECRET_KEY=dev_secret_key_change_in_production_32chars
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ─── File Storage ────────────────────────────────────────
UPLOAD_DIR=./uploads
STORAGE_BACKEND=local

# Video ingestion
ASR_MODEL=small
ASR_COMPUTE_TYPE=int8
SCENE_THRESHOLD=27.0
MAX_FRAMES=60
MAX_VIDEO_DURATION=1800
